{
  "name": "@cloner-template/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Private MCP tools that let ChatGPT operate an authorized ClonerTemplate workspace.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run --dir test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "cheerio": "1.2.0",
    "express": "5.2.1",
    "ipaddr.js": "1.9.1",
    "undici": "7.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.12.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
